# Copy to `.env` for local development. On a hosting platform, enter these in
# its "Environment Variables" screen instead. NEVER commit the real .env file.

# ---- required -------------------------------------------------------------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pyro?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string

# ---- strongly recommended -------------------------------------------------
SESSION_SECRET=change-me-to-another-long-random-string
# Password for the /admin dashboard. If unset, the admin API is disabled.
ADMIN_PASSWORD=change-me
# Public URL of the site, no trailing slash. Used in password-reset emails and
# the redirect after Google login. e.g. https://pyro.onrender.com
CLIENT_URL=http://localhost:5173

# ---- email (verification codes, password reset, order confirmation) --------
# Option A (recommended on cloud hosts - works over HTTPS, never blocked):
RESEND_API_KEY=
# Option B: SMTP. Gmail needs an "App Password". Many free hosts block SMTP ports.
SMTP_EMAIL=
SMTP_PASSWORD=
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# Optional sender override, e.g. "Pyro <no-reply@yourdomain.com>"
# EMAIL_FROM=

# ---- Google login ----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: pin the OAuth callback to an absolute URL
# GOOGLE_CALLBACK_URL=https://pyro.onrender.com/api/auth/google/callback

# ---- only needed for `npm run seed` (importing games from RAWG) ------------
RAWG_API_KEY=
BASE_URL=https://api.rawg.io/api/games

# ---- optional --------------------------------------------------------------
# Extra browser origins allowed to call the API (only if the frontend is hosted
# on a different domain than the backend). Comma-separated.
# CORS_ORIGINS=https://my-frontend.vercel.app
# PORT is injected by the hosting platform; defaults to 3000.
