# Base URL of the backend API, WITHOUT a trailing slash.
#
# - Leave this unset/empty when the backend serves the frontend (the default
#   single-service deployment) and for local `npm run dev` (Vite proxies /api
#   and /assets to http://localhost:3000).
# - Set it only when the frontend is hosted separately from the backend, e.g.
#   VITE_BACKEND_URL=https://pyro-api.onrender.com
#   Vite reads this at BUILD time, so set it in the platform's env vars before
#   building.
VITE_BACKEND_URL=
